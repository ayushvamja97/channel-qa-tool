# Copy to .env and replace all REPLACE values. Never commit real secrets.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=mysql://root:REPLACE_WITH_RANDOM_HEX@localhost:3307/channel_qa_tool
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_LOCAL_ADMIN_PASSWORD
SEED_USER_PASSWORD=REPLACE_WITH_A_LOCAL_USER_PASSWORD
SEED_DEMO_DATA=false

# Optional text AI (billed separately by the API provider).
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local CNN service, with no external image API.
VISION_SERVICE_URL=http://localhost:8000
VISION_SERVICE_TOKEN=REPLACE_WITH_RANDOM_SERVICE_TOKEN
CLASSIFIER_PATH=
CLASSIFIER_THRESHOLD=0.7
